# ─── Server Configuration ───
PORT=8000
HOST=0.0.0.0

# ─── OpenRouter Configuration (REQUIRED) ───
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Choose any model from OpenRouter:
# - meta-llama/llama-3.3-70b-instruct   (free & powerful)
# - deepseek/deepseek-chat               (fast & smart)
# - anthropic/claude-3.5-sonnet         (best quality)
# - google/gemini-2.0-flash-001         (Google's latest)
# - openai/gpt-4o-mini                  (cost-efficient)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
FAST_MODEL=openrouter/free

# ─── App Info ───
YOUR_SITE_URL=http://localhost:8000
YOUR_APP_NAME=Astra-CollegeBot
